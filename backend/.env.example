APP_ENV=development
DATABASE_URL=sqlite:///./globalroute_dev.db
# Set a strong random SECRET_KEY for production and for stable local sessions across restarts.
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000
WHATSAPP_API_URL=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# SMTP is required to send account verification codes.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_SSL=false
# This exact callback must also be registered in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://your-render-backend.onrender.com/api/v1/auth/google/callback
